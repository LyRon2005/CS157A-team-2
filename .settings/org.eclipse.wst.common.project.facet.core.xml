<?xml version="1.0" encoding="UTF-8"?>
<!--
Eclipse project capabilities. Use Java 17 and the installed Tomcat 11 runtime.
The web facet must match version 5.0 in WEB-INF/web.xml.
-->
<faceted-project>
  <runtime name="Apache Tomcat v11.0"/>
  <fixed facet="jst.web"/>
  <fixed facet="java"/>
  <fixed facet="wst.jsdt.web"/>
  <installed facet="java" version="17"/>
  <installed facet="jst.web" version="5.0"/>
  <installed facet="wst.jsdt.web" version="1.0"/>
</faceted-project>
