<?xml version="1.0" encoding="UTF-8"?>
<!--
Eclipse deployment layout. Copy webapp to the application root.
Publish compiled Java classes under WEB-INF/classes.
The context root gives the URL prefix /SJSUClassrooms/.
-->
<project-modules id="moduleCoreId" project-version="1.5.0">
        
    <wb-module deploy-name="SJSUClassrooms">
                
        <wb-resource deploy-path="/" source-path="/src/main/webapp" tag="defaultRootSource"/>
                
        <wb-resource deploy-path="/WEB-INF/classes" source-path="/src/main/java"/>
                
        <property name="java-output-path" value="/SJSUClassrooms/build/classes"/>
        <property name="context-root" value="SJSUClassrooms"/>
            
    </wb-module>
    
</project-modules>
